From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kvmem <kvmem@local>
Date: Fri, 4 Sep 2026 22:46:16 +0800
Subject: [PATCH 1/3] memory: add KVMem factory hook

---
 CMakeLists.txt            |  5 +++++
 common/speculative.cpp    |  5 ++++-
 src/CMakeLists.txt        | 26 ++++++++++++++++++++++++++
 src/llama-context.cpp     |  5 +++++
 src/llama-kvmem-factory.h | 16 ++++++++++++++++
 src/llama-model.cpp       |  7 +++++++
 6 files changed, 63 insertions(+), 1 deletion(-)
 create mode 100644 src/llama-kvmem-factory.h

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1d4bcf4..44f1470 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -128,6 +128,11 @@ option(LLAMA_SANITIZE_UNDEFINED "llama: enable undefined sanitizer" OFF)
 # utils
 option(LLAMA_BUILD_COMMON "llama: build common utils library" ${LLAMA_STANDALONE})
 
+# KVMem out-of-tree adapter (kvmem_llamacpp). Off by default so a vanilla
+# submodule build stays bit-identical to upstream.
+option(LLAMA_KVMEM "llama: compile KVMem memory adapter" OFF)
+set(LLAMA_KVMEM_ROOT "" CACHE PATH "kvmem_llamacpp root (libkvmem + src/adapter)")
+
 # extra artifacts
 option(LLAMA_BUILD_TESTS     "llama: build tests"                                                                ${LLAMA_STANDALONE})
 option(LLAMA_BUILD_TOOLS     "llama: build tools"                                                                ${LLAMA_STANDALONE})
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 8922dc1..e82e528 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -63,6 +63,32 @@ target_compile_features   (llama PRIVATE cxx_std_17) # don't bump
 
 target_link_libraries(llama PUBLIC ggml)
 
+if (LLAMA_KVMEM)
+    if (LLAMA_KVMEM_ROOT STREQUAL "")
+        message(FATAL_ERROR "LLAMA_KVMEM=ON requires LLAMA_KVMEM_ROOT")
+    endif()
+    target_sources(llama PRIVATE
+        ${LLAMA_KVMEM_ROOT}/src/adapter/llama-memory-kvmem.cpp
+        ${LLAMA_KVMEM_ROOT}/src/adapter/llama-memory-kvmem-hybrid.cpp
+        ${LLAMA_KVMEM_ROOT}/src/adapter/llama-memory-kvmem-mtp.cpp
+        ${LLAMA_KVMEM_ROOT}/src/adapter/llama-kvmem-batch.cpp
+        ${LLAMA_KVMEM_ROOT}/src/adapter/llama-kvmem-capture.cpp
+    )
+    target_include_directories(llama PRIVATE
+        ${LLAMA_KVMEM_ROOT}/kvmem/include
+        ${LLAMA_KVMEM_ROOT}/src/adapter
+    )
+    target_compile_definitions(llama PRIVATE LLAMA_KVMEM=1)
+    if (NOT TARGET kvmem)
+        add_subdirectory(${LLAMA_KVMEM_ROOT}/kvmem ${CMAKE_BINARY_DIR}/kvmem-from-llama)
+    endif()
+    target_link_libraries(llama PRIVATE kvmem)
+    find_package(CUDAToolkit QUIET)
+    if (CUDAToolkit_FOUND)
+        target_link_libraries(llama PRIVATE CUDA::cudart)
+    endif()
+endif()
+
 if (BUILD_SHARED_LIBS)
     set_target_properties(llama PROPERTIES POSITION_INDEPENDENT_CODE ON)
     target_compile_definitions(llama PRIVATE LLAMA_BUILD)
diff --git a/src/llama-kvmem-factory.h b/src/llama-kvmem-factory.h
new file mode 100644
index 0000000..8493b3e
--- /dev/null
+++ b/src/llama-kvmem-factory.h
@@ -0,0 +1,16 @@
+#pragma once
+
+// Thin hook used by llama_model::create_memory when LLAMA_KVMEM is enabled.
+// Implementation lives out-of-tree in src/adapter/.
+
+struct llama_memory_i;
+struct llama_model;
+struct llama_memory_params;
+struct llama_cparams;
+
+#if defined(LLAMA_KVMEM)
+llama_memory_i * llama_memory_kvmem_maybe_create(
+        const llama_model & model,
+        const llama_memory_params & params,
+        const llama_cparams & cparams);
+#endif
diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index bfce09d..2bfb8b6 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -18,6 +18,7 @@
 #include "llama-memory-hybrid-iswa.h"
 #include "llama-memory-hybrid-idx.h"
 #include "llama-memory-recurrent.h"
+#include "llama-kvmem-factory.h"
 
 #include "llama.h"
 #include "models/models.h"
@@ -2213,6 +2214,12 @@ ggml_tensor * llama_model::get_rope_factors(const llama_cparams & cparams, int i
 llama_memory_i * llama_model::create_memory(const llama_memory_params & params, const llama_cparams & cparams) const {
     llama_memory_i * res;
 
+#if defined(LLAMA_KVMEM)
+    if (llama_memory_i * kvmem = llama_memory_kvmem_maybe_create(*this, params, cparams)) {
+        return kvmem;
+    }
+#endif
+
     switch (arch) {
         // Models that need specific instantiation should be handled in the
         // switch statement
diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 0000000..0000001 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -146,6 +146,11 @@ llama_context::llama_context(
     cparams.ctx_other = nullptr;
 
+    if (params.ctx_type == LLAMA_CONTEXT_TYPE_MTP) {
+        cparams.ctx_other = params.ctx_other;
+    }
+
     // TODO: more generic
     if (model.arch == LLM_ARCH_GEMMA4_ASSISTANT) {
diff --git a/common/speculative.cpp b/common/speculative.cpp
index 0000000..0000001 100644
--- a/common/speculative.cpp
+++ b/common/speculative.cpp
@@ -1414,7 +1414,11 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
         llama_set_embeddings_nextn(ctx_tgt, true, /*masked*/ false);
         llama_set_embeddings_nextn(ctx_dft, true, /*masked*/ true);
 
-        is_mem_shared = llama_get_ctx_other(ctx_dft) == ctx_tgt;
+        // ctx_other is also set for Qwen MTP so the KVMem factory can follow
+        // the target slot-pool. Shared-KV (Gemma4) is the same memory object.
+        is_mem_shared = llama_get_ctx_other(ctx_dft) == ctx_tgt
+                && llama_get_memory(ctx_dft) == llama_get_memory(ctx_tgt);
         chain_heads   = n_mtp_layers > 1 && !is_mem_shared;

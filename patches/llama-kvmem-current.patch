+// batch-dependent kernels, so this is not a whole-model guarantee. Costs some throughput at
+// 2 to 4 columns.
+static inline bool ggml_cuda_batch_invariant() {
+    static const bool enabled = getenv("GGML_CUDA_BATCH_INVARIANT") != nullptr;
+    return enabled;
